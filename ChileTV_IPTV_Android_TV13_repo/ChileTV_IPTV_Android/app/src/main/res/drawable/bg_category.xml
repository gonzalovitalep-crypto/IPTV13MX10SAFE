<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#242A31" />
            <corners android:radius="18dp" />
            <stroke android:width="4dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#252D35" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#171C22" android:endColor="#20262D" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#303A44" />
        </shape>
    </item>
</selector>
