<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compatPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/compatGatePanel"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_search"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/compatGateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Canal"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/compatGateInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Modo seguro"
            android:textColor="#B9C0C7"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnCompatExternalPrimary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:text="VLC / reproductor externo · recomendado"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCompatInternal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_dark"
            android:focusable="true"
            android:text="Probar reproductor interno del MX10"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCompatBrowser"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_dark"
            android:focusable="true"
            android:text="Abrir con otro reproductor"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/compatPlayerLoading"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/compatPlayerOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC111419"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/compatPlayerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Canal"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="EN VIVO · motor nativo MX10"
                android:textColor="#B9C0C7"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCompatClose"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_dark"
            android:text="Cerrar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/compatErrorPanel"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_search"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/compatErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnCompatRetry"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="Reintentar interno"
                android:textAllCaps="false"
                android:textColor="#111111" />
            <Button
                android:id="@+id/btnCompatExternal"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:text="Abrir externo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
